{
  "name": "champions-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Assistente de teambuilder de alto nivel para Pokemon Champions (VGC doubles).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false",
    "mock": "node scripts/mock-api.mjs",
    "demo": "node scripts/mock-api.mjs & vite",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@pkmn/data": "^0.10.11",
    "@pkmn/dex": "^0.10.11",
    "@pkmn/img": "^0.3.4",
    "@pkmn/sets": "^5.2.0",
    "@smogon/calc": "^0.11.0",
    "idb-keyval": "^6.3.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "playwright": "^1.62.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.2.0"
  }
